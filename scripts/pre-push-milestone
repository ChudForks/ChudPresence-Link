#!/bin/sh
# Local safety guard: only the independent milestone main may be pushed to origin.
remote="$1"
while read local_ref local_oid remote_ref remote_oid; do
    if [ "$remote" != origin ] || [ "$local_ref" != refs/heads/main ] || [ "$remote_ref" != refs/heads/main ]; then
        echo 'Push blocked: only main -> origin/main is permitted by this repository workflow.' >&2
        exit 1
    fi
    if git merge-base --all refs/heads/dev "$local_oid" >/dev/null 2>&1; then
        echo 'Push blocked: main shares ancestry with local dev.' >&2
        exit 1
    fi
    if [ "$remote_oid" = 0000000000000000000000000000000000000000 ]; then
        commits=$(git rev-list "$local_oid") || exit 1
    else
        commits=$(git rev-list "$local_oid" "^$remote_oid") || exit 1
    fi
    for commit in $commits; do
        author=$(git show -s --format=%ae "$commit") || exit 1
        committer=$(git show -s --format=%ce "$commit") || exit 1
        if [ "$author" != '286146499+ChudForks@users.noreply.github.com' ] || [ "$committer" != '286146499+ChudForks@users.noreply.github.com' ]; then
            echo 'Push blocked: all new milestone commits must use the ChudForks GitHub no-reply address.' >&2
            exit 1
        fi
    done
done
