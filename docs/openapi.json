            "minLength": 1
          },
          "details": {
            "type": "string",
            "description": "At most 128 UTF-8 bytes; no control characters.",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "playing",
              "streaming",
              "listening",
              "watching",
              "competing"
            ],
            "default": "watching"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "description": "At most 128 UTF-8 bytes; no control characters."
              },
              {
                "type": "null"
              }
            ]
          },
          "statusDisplayType": {
            "type": "string",
            "enum": [
              "name",
              "state",
              "details"
            ],
            "default": "name"
          },
          "detailsUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "stateUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
