<Window
    x:Class="ChudPresence.Link.Windows.LinkWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ChudPresence Link">
    <Grid x:Name="Root" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent" Padding="18,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                <FontIcon Glyph="&#xE71B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="ChudPresence Link" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageContent" HorizontalAlignment="Stretch" Spacing="24" Padding="32,20,32,28">
                <TextBlock Text="Overview" Style="{ThemeResource TitleTextBlockStyle}" />

                <Border Style="{StaticResource SurfaceBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE968;" FontSize="20" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ConnectionStatus" Text="Link is running" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="PresenceDetails" Visibility="Collapsed" Style="{StaticResource CaptionTextStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="12" Padding="10,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock x:Name="StatusBadge" Text="Local network" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="EndpointColumn" Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Browser extension" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="BrowserAddress" IsTextSelectionEnabled="True" FontSize="14" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="CopyBrowser_Click" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Copy browser connection address" ToolTipService.ToolTip="Copy browser connection address">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                </Button>
                            </Grid>
                            <Grid x:Name="PhoneEndpoint" Grid.Column="1" Margin="24,0,0,0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8EA;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                    <TextBlock Text="Phone · same Wi-Fi or Ethernet" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox x:Name="PhoneAddress" MinWidth="0" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0,4,8,4" AutomationProperties.Name="Phone connection address" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="CopyPhone_Click" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Copy phone connection address" ToolTipService.ToolTip="Copy selected phone connection address">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                </Button>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid x:Name="Body" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SideColumn" Width="344" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="ServicesPanel" MaxWidth="856" HorizontalAlignment="Stretch" Spacing="12">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Shared services" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="ServiceCount" Grid.Column="1" Text="0 services" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Choose which settings your browser and phone share." Style="{StaticResource MutedTextStyle}" Margin="0,-6,0,4" />
                        <StackPanel x:Name="ServiceList" Spacing="10" />
                        <Border x:Name="EmptyServices" Style="{StaticResource SurfaceBorderStyle}" MinHeight="302">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="12" Margin="12,20">
                                <Grid HorizontalAlignment="Center" Height="60" Width="128" Margin="0,0,0,8">
                                    <Border Width="54" Height="54" CornerRadius="12" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <FontIcon Glyph="&#xE71B;" FontSize="14" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Border Width="44" Height="54" CornerRadius="12" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE8EA;" FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Better together" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyServicesHelp" Text="Pair your browser and phone. Services installed on both will appear here." Style="{StaticResource MutedTextStyle}" TextAlignment="Center" />
                                <Button Content="Pair your first device" Click="PairBrowser_Click" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,2,0,0">
                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Text="Only selected settings sync. Your media stays on each device." Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SidePanel" Grid.Column="1" Margin="24,0,0,0" Spacing="20">
                        <Border Style="{StaticResource SurfaceBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Link a device" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Create a one-time code, then enter it in your device's Link settings." Style="{StaticResource MutedTextStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="Pair browser" HorizontalAlignment="Stretch" Click="PairBrowser_Click" />
                                    <Button Grid.Column="1" Content="Pair phone" HorizontalAlignment="Stretch" Click="PairPhone_Click" />
                                </Grid>
                                <Border Padding="14" CornerRadius="6" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="PairingLabel" Text="PAIRING CODE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="PairingCode" Text="No active code" FontSize="16" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                                            <Button x:Name="CopyCode" Grid.Column="1" Visibility="Collapsed" Click="CopyCode_Click" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Copy pairing code" ToolTipService.ToolTip="Copy pairing code">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CodeHelp" Text="Codes expire after 5 minutes." Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                    <Button x:Name="CancelCode" Grid.Column="1" Content="Cancel" Visibility="Collapsed" Click="CancelCode_Click" Style="{StaticResource IconButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfaceBorderStyle}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Paired devices" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="DeviceCount" Grid.Column="1" Text="0" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="EmptyDevices" Spacing="10" Padding="8,18">
                                    <FontIcon Glyph="&#xE8F2;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="No devices paired yet" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Text="Your browser and phone will appear here." TextAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <ListView x:Name="Devices" SelectionMode="Single" MaxHeight="308" Margin="-8,0,-8,0" SelectionChanged="Devices_SelectionChanged" AutomationProperties.Name="Paired devices">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{Binding Glyph}" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button x:Name="RemoveDevice" Content="Remove device" Visibility="Collapsed" IsEnabled="False" Click="RemoveDevice_Click" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="Feedback" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Informational" Margin="24,0" AutomationProperties.LiveSetting="Polite" />

        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource LayerFillColorAltBrush}" Padding="24,10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ToggleSwitch x:Name="Startup" OffContent="Start with Windows" OnContent="Start with Windows" Toggled="Startup_Toggled" AutomationProperties.Name="Start with Windows" />
                <TextBlock Grid.Column="1" Text="Closes to the system tray" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Appearance" ToolTipService.ToolTip="Appearance">
                    <FontIcon Glyph="&#xE790;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="Use system setting" GroupName="Theme" IsChecked="True" Tag="Default" Click="Theme_Click" />
                            <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light" GroupName="Theme" Tag="Light" Click="Theme_Click" />
                            <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="3" Content="Exit Link" VerticalAlignment="Center" Click="Exit_Click" Style="{StaticResource IconButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
