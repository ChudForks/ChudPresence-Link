<ContentDialog
    x:Class="ChudPresence.Link.Windows.SyncSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    PrimaryButtonText="Enable sync"
    CloseButtonText="Cancel"
    PrimaryButtonClick="SaveClicked">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="610">
        <StackPanel Spacing="16" MinWidth="280" MaxWidth="520">
            <TextBlock Text="Choose which settings your devices share. Settings left unchecked stay local to each device."
                       TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
            <StackPanel Spacing="2">
                <RadioButton x:Name="AllSettings" GroupName="SyncScope" Content="All supported settings" Checked="ScopeChanged" />
                <RadioButton x:Name="SelectedSettings" GroupName="SyncScope" Content="Selected settings" Checked="ScopeChanged" />
            </StackPanel>
            <Border Style="{StaticResource SurfaceBorderStyle}" Padding="16,4">
                <StackPanel x:Name="FieldRows" />
            </Border>
            <ComboBox x:Name="SourceSelector" Header="Starting settings" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Starting settings source" SelectionChanged="SourceChanged" />
            <StackPanel Spacing="5">
                <TextBlock x:Name="SourceSummary" TextWrapping="Wrap" FontSize="12" />
                <TextBlock x:Name="SourceReported" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <TextBlock x:Name="SelectionHelp" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
